<script>
  // Hero video rotation
  const vids = [
    document.getElementById("heroVid1") as HTMLVideoElement,
    document.getElementById("heroVid2") as HTMLVideoElement,
    document.getElementById("heroVid3") as HTMLVideoElement,
  ];

  let current = 0;

  function playNext() {
    vids.forEach((v) => v.classList.remove("active"));
    const active = vids[current];
    active.classList.add("active");
    active.currentTime = 0;
    active.play();

    active.onended = () => {
      current = (current + 1) % vids.length;
      playNext();
    };
  }

  playNext();
</script>
