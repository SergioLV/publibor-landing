---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Publibor — Bordado, DTF y producción textil"
  description="Proveedor textil para marcas, empresas y revendedores. Bordado, DTF, texturizado y producción recurrente con respuesta comercial y cumplimiento."
>
  <!-- Header -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="PubliborChile">
        <img src="/pb_logo.svg" alt="PubliborChile" class="brand-icon" decoding="async" />
      </a>
      <a href="#contacto" class="header-cta">Cotizar pedido</a>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="eyebrow">Bordado · DTF · Texturizado</p>
        <h1>
          Producción textil para marcas y empresas.
          <span class="rotating-wrapper">
            <span class="rotating-words" aria-label="Bordados, DTF, Texturizado">
              <span class="rotating-word">DTF.</span>
              <span class="rotating-word">Texturizado.</span>
              <span class="rotating-word">Bordados.</span>
            </span>
          </span>
        </h1>
        <p class="hero-sub">
          Bordado, DTF, terminaciones y producción recurrente para pedidos comerciales, deportivos, promocionales e institucionales.
        </p>
        <div class="hero-ctas">
          <a href="#contacto" class="btn-primary">Cotizar pedido</a>
          <a href="#servicios" class="btn-secondary">Qué hacemos</a>
        </div>
      </div>
      <div class="hero-video">
        <video id="heroVid1" muted playsinline disablepictureinpicture preload="auto">
          <source src="/dtf/embroidery_clip.webm" type="video/webm" />
        </video>
        <video id="heroVid2" muted playsinline disablepictureinpicture preload="none">
          <source src="/dtf/dtf_clip.webm" type="video/webm" />
        </video>
        <video id="heroVid3" muted playsinline disablepictureinpicture preload="none">
          <source src="/dtf/laser_clip.webm" type="video/webm" />
        </video>
      </div>
    </div>
  </section>

  <!-- Positioning -->
  <section class="positioning">
    <div class="container">
      <div class="positioning-layout">
        <div class="positioning-text">
          <p class="eyebrow">Publibor</p>
          <h2>Un proveedor serio para pedidos que se repiten.</h2>
          <p>
            Trabajamos con marcas, distribuidores y empresas que necesitan sacar producción textil con respuesta, cumplimiento y consistencia entre corridas.
          </p>
        </div>
        <aside class="positioning-aside">
          <div class="positioning-image">
            <img src="/stacked_tshirts.webp" alt="Lote de poleras en producción" loading="lazy" decoding="async" width="600" height="450" />
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Logos -->
  <section class="logos">
    <div class="logos-top">
      <div class="container">
        <p class="logos-label">Marcas que producimos para nuestros clientes</p>
      </div>
    </div>
    <div class="marquee" aria-label="Logos de clientes">
      <div class="marquee-track">
        <img src="/logos/tesla.png" alt="Tesla" loading="lazy" />
        <img src="/logos/aws.png" alt="AWS" loading="lazy" />
        <img src="/logos/scania.png" alt="Scania" loading="lazy" />
        <img src="/logos/ecocopter.png" alt="Ecocopter" loading="lazy" />
        <img src="/logos/fach.svg" alt="FACH" loading="lazy" />
        <img src="/logos/udd.png" alt="UDD" loading="lazy" />
        <img src="/logos/unab.png" alt="UNAB" loading="lazy" />
        <img src="/logos/kami_sushi.png" alt="Kami Sushi" loading="lazy" />
        <!-- duplicate for seamless loop -->
        <img src="/logos/tesla.png" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/aws.png" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/scania.png" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/ecocopter.png" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/fach.svg" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/udd.png" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/unab.png" alt="" aria-hidden="true" loading="lazy" />
        <img src="/logos/kami_sushi.png" alt="" aria-hidden="true" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Production Floor -->
  <section id="servicios" class="floor">
    <div class="floor-header">
      <div class="container">
        <p class="eyebrow">Servicios y tipos de pedido</p>
        <h2>Producción según el tipo de pedido.</h2>
        <p class="floor-sub">Ajustamos producción, terminaciones y continuidad según el tipo de cliente, uso final y frecuencia del pedido.</p>
      </div>
    </div>
    <div class="floor-mosaic">
      <!-- Row 1: two large service tiles -->
      <article class="tile tile--lg">
        <img src="/dtf_image.jpg" alt="DTF" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Servicio</span>
          <h3>DTF</h3>
          <p>Impresión directa con plotter DTF sobre poleras, polerones y bolsas. Alta definición y colores firmes.</p>
        </div>
      </article>
      <article class="tile tile--lg">
        <img src="/embroidery_image.jpg" alt="Bordado y corte láser" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Servicio</span>
          <h3>Bordado y corte láser</h3>
          <p>Bordado para uniformes y merchandising. Corte láser para un terminado limpio y profesional.</p>
        </div>
      </article>
      <!-- Row 2: four tipo de pedido tiles -->
      <article class="tile tile--sm">
        <img src="/images/ropa_deportiva.png" alt="Equipos y deporte" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Tipo de pedido</span>
          <h3>Equipos y deporte</h3>
          <p>Series para clubes, academias, torneos y eventos.</p>
        </div>
      </article>
      <article class="tile tile--sm">
        <img src="/images/ropa_trabajo.png" alt="Uniformes de trabajo" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Tipo de pedido</span>
          <h3>Uniformes de trabajo</h3>
          <p>Prendas para operación diaria, atención y terreno.</p>
        </div>
      </article>
      <article class="tile tile--sm">
        <img src="/images/merch.webp" alt="Merch para marcas" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Tipo de pedido</span>
          <h3>Merch para marcas</h3>
          <p>Textil para venta, posicionamiento y comunidad.</p>
        </div>
      </article>
      <article class="tile tile--sm">
        <img src="/images/activations.png" alt="Campañas y activaciones" loading="lazy" decoding="async" />
        <div class="tile-overlay">
          <span class="tile-label">Tipo de pedido</span>
          <h3>Campañas y activaciones</h3>
          <p>Producción para acciones promocionales y lanzamientos.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- Trayectoria -->
  <section class="trayectoria">
    <div class="container">
      <div class="tray-layout">
        <!-- Left: anchor block -->
        <div class="tray-anchor">
          <p class="eyebrow">Trayectoria</p>
          <div class="tray-number">
            <span class="tray-big">20</span>
            <div class="tray-number-side">
              <span class="tray-plus">+</span>
              <span class="tray-unit">años en<br />producción textil</span>
            </div>
          </div>
          <p class="tray-anchor-text">
            Desde 2004 desarrollando capacidad productiva en bordado, DTF y personalización para el mercado comercial e institucional chileno.
          </p>
        </div>
        <!-- Right: evidence list -->
        <div class="tray-evidence">
          <article class="tray-item">
            <span class="tray-item-label">ChileCompra</span>
            <h3>Compras públicas y licitaciones</h3>
            <p>Operamos dentro del sistema de compras del Estado. Conocemos los procesos, plazos, documentación y exigencias que implica trabajar con el sector público.</p>
          </article>
          <article class="tray-item">
            <span class="tray-item-label">Operación</span>
            <h3>Capacidad que crece con la demanda</h3>
            <p>Incorporamos tecnología y ajustamos procesos según lo que el mercado pide. No prometemos lo que no podemos producir.</p>
          </article>
          <article class="tray-item">
            <span class="tray-item-label">Continuidad</span>
            <h3>Clientes que vuelven</h3>
            <p>Marcas, empresas e instituciones que repiten pedidos porque la operación funciona, los plazos se cumplen y la calidad se mantiene.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA + Contact -->
  <section id="contacto" class="contact">
    <div class="container">
      <div class="contact-header">
        <p class="eyebrow">Contacto</p>
        <h2>Hablemos de tu próximo pedido.</h2>
        <p class="contact-support">Cuéntanos qué necesitas producir, en qué plazos y para qué tipo de proyecto.</p>
      </div>
      <div class="contact-layout">
        <!-- Form -->
        <form class="contact-form" action="#" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Nombre</label>
              <input type="text" id="name" name="name" placeholder="Tu nombre" required />
            </div>
            <div class="form-group">
              <label for="company">Empresa</label>
              <input type="text" id="company" name="company" placeholder="Nombre de tu empresa" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="email">Correo</label>
              <input type="email" id="email" name="email" placeholder="correo@empresa.cl" required />
            </div>
            <div class="form-group">
              <label for="phone">Teléfono</label>
              <input type="tel" id="phone" name="phone" placeholder="+56 9 ..." />
            </div>
          </div>
          <div class="form-group">
            <label for="message">¿Qué necesitas producir?</label>
            <textarea id="message" name="message" rows="4" placeholder="Tipo de pedido, cantidades, aplicación, plazos..." required></textarea>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-primary">Enviar requerimiento</button>
            <a href="https://wa.me/56956791655" target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
          </div>
        </form>
        <!-- Map + Info -->
        <div class="contact-side">
          <div class="contact-map">
            <iframe
              src="https://www.google.com/maps?q=Ureta+Cox+233,+San+Joaqu%C3%ADn,+Santiago,+Chile&output=embed"
              width="100%"
              height="280"
              style="border:0;border-radius:16px;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación Publibor"
            ></iframe>
          </div>
          <div class="contact-info">
            <div class="info-item">
              <strong>Dirección</strong>
              <p>Ureta Cox 233, San Joaquín, Santiago</p>
            </div>
            <div class="info-item">
              <strong>Horario</strong>
              <p>Lunes a viernes, 8:30 a 18:00</p>
            </div>
            <div class="info-item">
              <strong>Correo</strong>
              <p><a href="mailto:publiborchile@gmail.com">publiborchile@gmail.com</a></p>
            </div>
            <div class="info-item">
              <strong>Teléfono</strong>
              <p><a href="tel:+56956791655">+56 9 5679 1655</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="site-footer">

  <!-- Floating WhatsApp -->
  <a href="https://wa.me/56956791655" target="_blank" rel="noopener noreferrer" class="fab-whatsapp" aria-label="Contactar por WhatsApp">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <a href="/" class="brand brand--footer" aria-label="PubliborChile">
            <img src="/pb_logo.svg" alt="PubliborChile" class="brand-icon" />
          </a>
          <p>Producción textil comercial</p>
        </div>
        <div class="footer-contact">
          <p>Ureta Cox 233, San Joaquín, Santiago</p>
          <p>Lunes a viernes, 8:30 a 18:00</p>
        </div>
        <div class="footer-contact">
          <p><a href="mailto:publiborchile@gmail.com">publiborchile@gmail.com</a></p>
          <p><a href="tel:+56956791655">+56 9 5679 1655</a></p>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="footer-copy">&copy; 2025 Publibor</p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  :root {
    --gold: #f3c242;
    --black: #000;
    --near-black: #0c0c0c;
    --white: #fff;
    --off-white: #f6f5f3;
    --gray-100: #edeceb;
    --gray-200: #dddcda;
    --gray-400: #a19d98;
    --gray-600: #5c5854;
    --gray-800: #2a2826;
    --font: system-ui, -apple-system, "Segoe UI", sans-serif;
    --max-w: 1140px;
    --py: clamp(3.5rem, 10vw, 8rem);
  }

  .container {
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 640px) {
    .container { padding-inline: 1.5rem; }
  }

  .eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.2rem;
  }

  /* ── Header ── */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 1rem 0;
  }

  @media (min-width: 640px) {
    .site-header { padding: 1.5rem 0; }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .brand-icon {
    display: block;
    filter: brightness(0) invert(1);
  }

  .site-header .brand-icon {
    width: auto;
    height: 56px;
  }

  @media (min-width: 640px) {
    .site-header .brand-icon {
      height: 72px;
    }
  }

  .brand--footer .brand-icon {
    width: auto;
    height: 44px;
  }

  .header-cta {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--black);
    background: var(--gold);
    padding: 0.55rem 1rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: background 0.2s;
  }

  @media (min-width: 640px) {
    .header-cta {
      font-size: 0.72rem;
      padding: 0.6rem 1.4rem;
    }
  }

  .header-cta:hover { background: #e5b63b; }

  /* ── Buttons ── */
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    padding: 0.95rem 1.8rem;
    min-height: 48px;
    text-decoration: none;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  @media (max-width: 479px) {
    .btn-primary,
    .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }

  @media (min-width: 640px) {
    .btn-primary,
    .btn-secondary {
      font-size: 0.8rem;
      padding: 0.95rem 2.2rem;
    }
  }

  .btn-primary {
    background: var(--gold);
    color: var(--black);
  }
  .btn-primary:hover { background: #e5b63b; }

  .btn-secondary {
    background: transparent;
    color: var(--gray-800);
    border: 1px solid var(--gray-200);
  }
  .btn-secondary:hover { border-color: var(--gray-400); }

  /* ── Hero ── */
  .hero {
    background: var(--near-black);
    color: var(--white);
    position: relative;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 140px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%, transparent 100%);
    z-index: 5;
    pointer-events: none;
  }

  .hero-inner {
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: 1.25rem;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 640px) {
    .hero-inner { padding-inline: 1.5rem; }
  }

  @media (min-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      min-height: 80vh;
      min-height: 80dvh;
    }
  }

  .hero-content {
    padding: clamp(6rem, 14vw, 7rem) 0 clamp(2rem, 4vw, 3rem);
    max-width: 540px;
  }

  @media (min-width: 820px) {
    .hero-content {
      padding: clamp(4rem, 10vw, 7rem) 0;
    }
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.03em;
  }
  .rotating-wrapper {
    display: block;
    height: 1.1em;
    overflow: hidden;
    position: relative;
  }

  .rotating-words {
    display: block;
    animation: rotate-words 6s infinite;
  }

  .rotating-word {
    display: block;
    height: 1.1em;
    line-height: 1.1;
    color: var(--gold);
  }

  @keyframes rotate-words {
    0%, 26% { transform: translateY(0); }
    33%, 59% { transform: translateY(-1.1em); }
    66%, 92% { transform: translateY(-2.2em); }
    100% { transform: translateY(0); }
  }

  .hero-sub {
    margin-top: 1.25rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--gray-400);
    max-width: 440px;
  }

  .hero-ctas {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 480px) {
    .hero-ctas {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .hero .btn-secondary {
    color: var(--white);
    border-color: rgba(255,255,255,0.15);
  }
  .hero .btn-secondary:hover { border-color: rgba(255,255,255,0.35); }

  /* Hero video */
  .hero-video {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  @media (min-width: 820px) {
    .hero-video {
      aspect-ratio: auto;
      align-self: stretch;
    }
  }

